+    # Quotation convention: paired quotation marks denote literal source text.
+    # Titles and labels use italics or plain text. No minimum word count.
+    QUOTE = re.compile(r'„([^“]+)“|“([^”]+)”|»([^«]+)«|«([^»]+)»|‚([^‘]+)‘|‘([^’]+)’|"([^"]+)"')
+    OMIT = re.compile(r"\[\s*(?:…|\.{3})\s*\]|\(\s*(?:…|\.{3})\s*\)")
+
+    def literal_normalize(text):
+        text = unicodedata.normalize("NFC", text).replace("\u00ad", "")
+        text = re.sub(r"(?<=\w)-[ \t]*\r?\n[ \t]*(?=[a-zäöüß])", "", text)
+        text = text.translate(str.maketrans({
+            "„": '"', "“": '"', "”": '"', "»": '"', "«": '"',
+            "‚": "'", "‘": "'", "’": "'", "\u2010": "-", "\u2011": "-"
+        }))
+        return re.sub(r"\s+", " ", text).strip()
+
+    def quoted_text(match):
+        return next(value for value in match.groups() if value is not None)
+
+    def literal_match(quote, original):
+        # Only explicitly marked omissions are allowed. Segments must be
+        # consecutive in order within ONE registered passage, never combined.
+        segments = [literal_normalize(x) for x in OMIT.split(quote)]
+        if not segments or any(not x for x in segments):
+            return False
+        source = literal_normalize(original)
+        offset = 0
+        for segment in segments:
+            pattern = (r"(?<!\w)" if segment[0].isalnum() else "") + re.escape(segment)
+            if segment[-1].isalnum():
+                pattern += r"(?!\w)"
+            match = re.compile(pattern).search(source, offset)
+            if match is None:
+                return False
+            offset = match.end()
+        return True
+
+    def validate_quotations(answer, registered):
+        # Associate a quote with the next citation run on the same line.
+        # Do not borrow a citation from an earlier or a subsequent sentence.
+        for line in answer.splitlines():
+            for quote in QUOTE.finditer(line):
+                citation = CITATION_RUN.search(line, quote.end())
+                if citation is None:
+                    raise GuardError("Originalzitat ohne nachfolgende Quellenkennung in derselben Zeile")
+                bridge = line[quote.end():citation.start()]
+                # A terminal punctuation mark immediately before the citation
+                # is legitimate; a new sentence in between is not.
+                masked_bridge = QUOTE.sub("", bridge).rstrip(" \t.!?")
+                # A sentence-ending mark can occur INSIDE the quotation.
+                # In that case require the citation immediately afterwards
+                # (only whitespace, punctuation or closing Markdown).
+                if (quoted_text(quote).rstrip().endswith((".", "!", "?"))
+                        and not re.fullmatch(r"[\s.,;:!?*_]*", bridge)):
+                    raise GuardError("Originalzitat mit Satzabschluss ohne unmittelbar zugeordneten Beleg")
+                if re.search(r"[.!?]\s+\S", masked_bridge):
+                    raise GuardError("Originalzitat ohne eindeutig zugeordneten Beleg")
+                ids = cited_ids(citation.group())
+                if not any(literal_match(quoted_text(quote), registered[sid].get("content", ""))
+                           for sid in ids if sid in registered):
+                    raise GuardError("Originalzitat stimmt nicht mit zugeordneter gelesener Passage überein")
+            if re.search(r'[„“”»«‚‘’"]', QUOTE.sub("", line).replace("’", "")):
+                raise GuardError("Nicht eindeutig geschlossene Anführungszeichen; Originalzitate eindeutig markieren")
+
+    def strip_model_sources(answer):
+        """The pipe alone renders provenance. Remove only a recognizable trailing list."""
+        lines = answer.splitlines()
+        for i, line in enumerate(lines):
+            heading = re.sub(r"[*#]", "", line).strip().rstrip(":").strip()
+            if not re.fullmatch(
+                r"(?i)(?:Quellen?|Quellenangaben|Quellenverzeichnis|Belege|Nachweise|Literatur|"
+                r"Tatsächlich gelesene Originalstellen)", heading):
+                continue
+            tail = [x.strip() for x in lines[i+1:] if x.strip()]
+            if any(not re.match(r"^(?:[-*]\s+|\d+\.\s+)?\[S\d+\]", x) for x in tail):
+                raise GuardError("Quellenverzeichnis ausschließlich durch die Pipe erzeugen; keine weiteren Inhalte nach der Quellenüberschrift")
+            return "\n".join(lines[:i]).strip()
+        return answer.strip()
+

+    def validate_edit_quotations(answer, original):
+        for match in QUOTE.finditer(answer):
+            if not literal_match(quoted_text(match), original):
+                raise GuardError("Neues oder verändertes Zitat bei reiner Sprachrevision")
+
+    def edit_input(question):
+        """Only explicit, narrowly scoped language revisions with supplied text."""
+        instruction, sep, body = question.strip().partition(":")
+        if not sep or not body.strip():
+            return None
+        if not re.fullmatch(
+            r"(?i)(?:bitte\s+)?(?:"
+            r"(?:kürze|kuerze|korrigiere|überarbeite|ueberarbeite)\s+"
+            r"(?:den folgenden text|den text|den folgenden absatz|den absatz|meinen satz)\s+"
+            r"(?:rein|nur|ausschließlich|ausschliesslich)\s+sprachlich"
+            r"|(?:korrigiere|prüfe)\s+(?:nur\s+)?(?:rechtschreibung|grammatik|rechtschreibung und grammatik)"
+            r"|formuliere\s+(?:den folgenden text|den text)\s+rein sprachlich um"
+            r")\s*", instruction.strip()):
+            return None
+        return body.strip()
